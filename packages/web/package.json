{
  "name": "@openscout/web",
  "version": "0.5.4",
  "private": true,
  "description": "Full local Scout client and isolated inspection server",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "type": "module",
  "exports": {
    "./feed": "./client/screens/feed/index.ts",
    "./board": "./client/screens/work/content.tsx",
    "./chat": "./client/screens/chat/index.ts",
    "./sessions": "./client/screens/sessions/index.ts",
    "./search": "./client/screens/search/index.ts",
    "./control": "./client/screens/ops/index.ts"
  },
  "scripts": {
    "build": "bun run build:client && bun run build:server",
    "build:client": "RAYON_NUM_THREADS=1 GOMAXPROCS=1 NODE_OPTIONS=--max-old-space-size=1408 vite build",
    "build:server": "bun build ./server/inspect.ts ./server/background-reads-worker.ts ./server/knowledge-index-child.ts --target=bun --format=esm --outdir=dist --entry-naming=[name].mjs --banner 'import \"reflect-metadata\";'",
    "start": "exec bun --no-env-file dist/inspect.mjs",
    "check": "GOMEMLIMIT=1600MiB GOMAXPROCS=3 node ./scripts/typecheck.mjs",
    "test": "bun test --isolate client/screens/feed"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@hudsonkit/arc": "0.15.1",
    "@lydell/node-pty": "1.2.0-beta.12",
    "@openscout/pairing": "file:../../vendor/pairing-0.5.4-public.tgz",
    "@shikijs/langs": "4.3.1",
    "@voxd/client": "0.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hudsonkit": "0.3.5",
    "lucide-react": "0.577.0",
    "motion": "12.40.0",
    "picomatch": "4.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "reflect-metadata": "0.2.2",
    "remark-gfm": "4.0.1",
    "shiki": "4.3.1",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "uqr": "0.1.3",
    "ws": "8.21.0",
    "@openscout/scout": "0.5.4"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "@openscout/agent-sessions": "file:../../vendor/agent-sessions-0.5.4.tgz",
    "@openscout/protocol": "0.5.4",
    "@openscout/runtime": "file:../../vendor/runtime-0.5.4-public.tgz",
    "@pierre/diffs": "1.2.7",
    "@tailwindcss/vite": "4.2.2",
    "@trpc/client": "11.17.0",
    "@trpc/server": "11.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react-swc": "4.3.0",
    "bun-types": "1.3.11",
    "happy-dom": "21.0.4",
    "hono": "4.12.10",
    "tailwindcss": "4.2.2",
    "typescript": "7.0.2",
    "vite": "7.3.1",
    "zod": "4.6.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "24.12.2"
  }
}
